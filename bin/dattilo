#!/usr/bin/env bash
# dattilo: scrivi codice alla velocità delle mani. Senza argomenti apre l'app.
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
if ! command -v nvim >/dev/null 2>&1; then
  echo "dattilo: serve Neovim (nvim) 0.12 o più recente" >&2
  exit 1
fi
cli() { nvim --clean --headless -l "$DIR/lua/dattilo/cli.lua" "$@"; }
case "${1:-}" in
  importa)
    shift
    [ -n "${1:-}" ] || { echo "uso: dattilo importa <file.dattilo> [--si]"; exit 1; }
    file="$1"; shift
    cli importa "$file" --anteprima || exit 1
    if [[ " $* " != *" --si "* ]]; then
      read -r -p "Installare? [s/N] " risposta
      [[ "$risposta" =~ ^[sSyY] ]] || { echo "Annullato."; exit 0; }
    fi
    cli importa "$file" --si ;;
  esporta|pacchetti|nuovo|controlla|riempi) cli "$@" ;;
  aiuto|-h|--help) cli aiuto; echo "Senza argomenti: apre l'app." ;;
  vivo)
    case "${2:-}" in
      --dove) cli vivo-dove; exit $? ;;
      # exec: un segnale (la mod che dopo il tetto ferma il comando) arriva a Neovim, non si ferma a bash
      --prova) shift 2; exec nvim --clean --headless -l "$DIR/lua/dattilo/cli.lua" vivo-prova "$@" ;;
    esac
    [ -d "${2:-}" ] || { echo "uso: dattilo vivo <cartella> [opzioni di nvim]" >&2; exit 1; }
    # assoluta: Neovim può cambiare cartella, e i percorsi relativi non varrebbero più
    cartella="$(CDPATH= cd -- "$2" && pwd)" || { echo "uso: dattilo vivo <cartella> [opzioni di nvim]" >&2; exit 1; }
    export XDG_DATA_HOME="$cartella/dati" DATTILO_VIVO="$cartella" LANGUAGE=it
    shift 2
    exec nvim --clean -u "$DIR/init.lua" "$@" ;;
  *) exec nvim --clean -u "$DIR/init.lua" "$@" ;;
esac
